NODE_ENV=development
PORT=3001
API_PREFIX=api

DATABASE_URL=postgresql://labpath:labpath@localhost:5434/labpath?schema=public
DATABASE_URL_WORKER=postgresql://labpath:labpath@localhost:5434/labpath
# Neon: set DATABASE_URL / DATABASE_URL_WORKER to the pooled URL and DIRECT_URL to the non-pooler URL.
DIRECT_URL=postgresql://labpath:labpath@localhost:5434/labpath

REDIS_URL=redis://localhost:6382
# Upstash / TLS: use rediss:// (double s), e.g. rediss://default:TOKEN@HOST.upstash.io:6379

JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3000
# For Vercel+Render: CORS_ORIGINS=https://bina-learningapp.vercel.app,http://localhost:3000
# Leave empty / unset in split deploy (do not set localhost when API is on Render)
COOKIE_DOMAIN=
INGEST_SIGNING_SECRET=change-me-ingest

PUBLIC_WEB_URL=http://localhost:3000
# For Vercel: PUBLIC_WEB_URL=https://bina-learningapp.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Agent / sandbox (local dogfood — required for Agent track)
# 1) docker compose up -d sandbox-gateway
# 2) docker build -t labpath-sandbox:local infra/sandbox
# Containers reach the gateway on the Compose network (do not use localhost here).
SANDBOX_GATEWAY_URL=http://sandbox-gateway:8080
SANDBOX_DOCKER_NETWORK=labpath_sandbox
# Dev machines without gVisor: keep true. Never enable in production.
SANDBOX_ALLOW_RUNC_FALLBACK=true

# Assessment result signing (Ed25519 — O12). Dev auto-generates when unset.
# Generate keys: node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('ed25519');const id='labpath-2026-01';console.log('LABPATH_SIGNING_ACTIVE_KEY_ID='+id);console.log('LABPATH_SIGNING_PRIVATE_KEY='+privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log('LABPATH_SIGNING_PUBLIC_KEYS='+JSON.stringify({[id]:publicKey.export({type:'spki',format:'der'}).toString('base64')}));"
LABPATH_SIGNING_ACTIVE_KEY_ID=
LABPATH_SIGNING_PRIVATE_KEY=
LABPATH_SIGNING_PUBLIC_KEYS=

# Landing simulator preview (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
