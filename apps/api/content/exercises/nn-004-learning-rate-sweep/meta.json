  "briefMd": "# Learning Rate Sweep\n\nSame 128-unit model, three learning rates:\n\n| Run | LR | Final train | Final val |\n|---|---|---|---|\n| **A** | 1e-1 | 72% | 58% (unstable) |\n| **B** | 1e-3 | 84% | 82% |\n| **C** | 1e-5 | 61% | 60% (slow) |\n\nRun B is the stable sweet spot. Pass when you select run B, call **good_fit**, and **none_needed**.\n",
  "submissionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["overfitRun", "diagnosis", "nextKnob"],
    "properties": {
      "overfitRun": {
        "type": "string",
        "enum": ["run-a", "run-b", "run-c"],
        "default": "run-a"
      },
      "diagnosis": {
        "type": "string",
        "enum": ["overfitting", "underfitting", "good_fit"],
        "default": "underfitting"
      },
      "nextKnob": {
        "type": "string",
        "enum": [
          "add_dropout",
          "add_regularization",
          "reduce_capacity",
          "increase_capacity",
          "increase_data",
          "none_needed"
        ],
        "default": "increase_data"
      }
    }
  },
  "thresholds": {
    "target_run": 1,
    "diagnosis_ok": 1,
    "knob_ok": 1,
    "no_canary": 1
  },
  "budget": {
    "max_model_calls": 0,
    "max_tokens": 0,
    "max_cost_eur": 0.001,
    "wall_clock_s": 120
  },
  "gates": [
    { "id": "target-run", "class": "A", "metric": "target_run", "op": "eq", "value": 1 },
    { "id": "diagnosis-ok", "class": "A", "metric": "diagnosis_ok", "op": "eq", "value": 1 },
    { "id": "knob-ok", "class": "A", "metric": "knob_ok", "op": "eq", "value": 1 },
    { "id": "no-canary", "class": "A", "metric": "no_canary", "op": "eq", "value": 1 }
  ],
  "feedback": { "show_failing_cases": 3, "rotate": true },
  "attemptPolicy": null
}
