  "briefMd": "# Phase 4 · Rerank to Full Recall on a Tight Budget\n\nEvery hidden question must find its answer, with a prompt of about one chunk. Without rerank the gold chunk sometimes sits just below your cut-off; reranking lets you keep k small and still catch it.\n\nThe split is fixed (sentence packing, no overlap); every retrieved chunk is sent to the model in full.\n\n**Gates:** recall@k = 1.00 (every question) and mean prompt tokens ≤ 120 on the hidden set.\n",
  "submissionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "topK",
      "rerank",
      "chunkSize"
    ],
    "properties": {
      "topK": {
        "type": "integer",
        "minimum": 1,
        "maximum": 40,
        "default": 20
      },
      "rerank": {
        "type": "boolean",
        "default": false
      },
      "chunkSize": {
        "type": "integer",
        "minimum": 50,
        "maximum": 2000,
        "default": 400
      }
    }
  },
  "thresholds": {
    "mean_prompt_tokens": 120,
    "recall_at_k": 1.0
  },
  "budget": {
    "max_model_calls": 0,
    "max_tokens": 0,
    "max_cost_eur": 0.02,
    "wall_clock_s": 120
  },
  "gates": [
    {
      "id": "mean-prompt-tokens",
      "class": "A",
      "metric": "mean_prompt_tokens",
      "op": "lte",
      "value": 120
    },
    {
      "id": "recall-at-k",
      "class": "A",
      "metric": "recall@k",
      "op": "gte",
      "value": 1.0
    }
  ],
