  "briefMd": "# Phase 4 · Title-Aware Reranking\n\nPolicy questions usually name their topic, and every policy document has a title. Pick the reranker that uses that signal and lift nDCG@5 well above the keyword-count first stage.\n\nYou control the **reranker** (`none` / `title-boost` / `mmr`), **rerankTopN** (the candidate window) and an optional **query rewrite prompt**. The first stage is a plain keyword count over whole documents, so keyword-stuffed noise documents often outrank the right policy. The rewrite prompt costs one model call per question; the rewritten query is not used for ranking yet.\n\n**Gates:** nDCG@5 improves by at least 0.20, context tokens ≤ 3000, ≤ 2 model calls per question.\n",
  "submissionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reranker",
      "rerankTopN"
    ],
    "properties": {
      "reranker": {
        "type": "string",
        "enum": [
          "none",
          "title-boost",
          "mmr"
        ],
        "default": "none"
      },
      "rerankTopN": {
        "type": "integer",
        "minimum": 5,
        "maximum": 50,
        "default": 20
      },
      "queryRewritePrompt": {
        "type": "string",
        "default": ""
      }
    }
  },
  "thresholds": {
    "ndcg_improvement": 0.2,
    "context_tokens": 3000,
    "model_calls_per_question": 2
  },
  "budget": {
    "max_model_calls": 50,
    "max_tokens": 80000,
    "max_cost_eur": 0.2,
    "wall_clock_s": 180
  },
  "gates": [
    {
      "id": "ndcg-improvement",
      "class": "A",
      "metric": "ndcg_improvement",
      "op": "gte",
      "value": 0.2
    },
    {
      "id": "context-tokens",
      "class": "A",
      "metric": "context_tokens",
      "op": "lte",
      "value": 3000
    },
    {
      "id": "model-calls",
      "class": "A",
      "metric": "model_calls_per_question",
      "op": "lte",
      "value": 2
    }
  ],
