  "briefMd": "# Phase 2 · Keep the Heading with the Row\n\nThe hardware catalogue is markdown: one page per category (Laptops, Monitors, Headsets…), a section per range, and a table per section. Every table uses the same model names (Air, Pro, Max, Mini), so a row on its own, such as `| Pro | 32 GB | 929 euros |`, could be any category in any range. Only the page title and the section heading say which \"Pro\" it is.\n\nYou control **chunk size**, **overlap** and **split strategy**. Retrieval is BM25, top 5 chunks. A question counts when the chunk holding its table row is retrieved.\n\n**Gates:** recall@5 ≥ 0.90 and mean context tokens (top-5 chunks) ≤ 165 on the hidden set.\n",
  "submissionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "chunkSize",
      "overlap",
      "splitStrategy"
    ],
    "properties": {
      "chunkSize": {
        "type": "integer",
        "minimum": 50,
        "maximum": 2000,
        "default": 400
      },
      "overlap": {
        "type": "integer",
        "minimum": 0,
        "maximum": 400,
        "default": 50
      },
      "splitStrategy": {
        "type": "string",
        "enum": [
          "fixed",
          "sentence",
          "recursive",
          "heading-aware"
        ],
        "default": "sentence"
      }
    }
  },
  "thresholds": {
    "recall_at_5": 0.9,
    "mean_context_tokens": 165
  },
  "budget": {
    "max_model_calls": 0,
    "max_tokens": 0,
    "max_cost_eur": 0.02,
    "wall_clock_s": 120
  },
  "gates": [
    {
      "id": "recall-at-5",
      "class": "A",
      "metric": "recall@5",
      "op": "gte",
      "value": 0.9
    },
    {
      "id": "mean-context-tokens",
      "class": "A",
      "metric": "mean_context_tokens",
      "op": "lte",
      "value": 165
    }
  ],
  "feedback": {
    "show_failing_cases": 3,
    "rotate": true
  },
  "attemptPolicy": {
    "maxSubmissions": 20,
    "cooldownHours": 1
  },
  "graderArchetype": "rag-r1",
  "corpusFile": "hardware-catalog"
}
