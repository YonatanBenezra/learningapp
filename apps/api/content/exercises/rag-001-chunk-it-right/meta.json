  "briefMd": "# Phase 1 · Corpus Normalization & Chunk Boundaries\n\nProduction RAG is failing on an internal policy corpus: answers exist in source docs but **never appear in retrieved chunks**. The embedding model is fine — boundaries are wrong.\n\nTune **chunk size**, **overlap**, and **split strategy** (`fixed`, `sentence`, `recursive`, `heading-aware`). Baseline recall@5 ≈ 0.41 on the hidden eval.\n\n**Gate:** recall@5 ≥ 0.80 (same bar used for internal KB launch reviews).\n",
  "submissionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "chunkSize",
      "overlap",
      "splitStrategy"
    ],
    "properties": {
      "chunkSize": {
        "type": "integer",
        "minimum": 50,
        "maximum": 2000,
        "default": 400
      },
      "overlap": {
        "type": "integer",
        "minimum": 0,
        "maximum": 400,
        "default": 50
      },
      "splitStrategy": {
        "type": "string",
        "enum": [
          "fixed",
          "sentence",
          "recursive",
          "heading-aware"
        ],
        "default": "sentence"
      }
    }
  },
  "thresholds": {
    "recall_at_5": 0.8
  },
  "budget": {
    "max_model_calls": 0,
    "max_tokens": 0,
    "max_cost_eur": 0.02,
    "wall_clock_s": 120
  },
  "gates": [
    {
      "id": "recall-at-5",
      "class": "A",
      "metric": "recall@5",
      "op": "gte",
      "value": 0.8
    }
  ],
