  "briefMd": "# Phase 5 · Context Packing Under Token Budget\n\nPack the **maximum signal** into a small context window: tune top-k, rerank and chunk size so the gold sentence is in the context while the prompt stays tiny.\n\nThe split is fixed (sentence packing, no overlap); every retrieved chunk is sent to the model in full.\n\n**Gates:** recall@k ≥ 0.95 and mean prompt tokens ≤ 120 on the hidden set.\n",
  "submissionSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "topK",
      "rerank",
      "chunkSize"
    ],
    "properties": {
      "topK": {
        "type": "integer",
        "minimum": 1,
        "maximum": 40,
        "default": 20
      },
      "rerank": {
        "type": "boolean",
        "default": false
      },
      "chunkSize": {
        "type": "integer",
        "minimum": 50,
        "maximum": 2000,
        "default": 400
      }
    }
  },
  "thresholds": {
    "mean_prompt_tokens": 120,
    "recall_at_k": 0.95
  },
  "budget": {
    "max_model_calls": 0,
    "max_tokens": 0,
    "max_cost_eur": 0.02,
    "wall_clock_s": 120
  },
  "gates": [
    {
      "id": "mean-prompt-tokens",
      "class": "A",
      "metric": "mean_prompt_tokens",
      "op": "lte",
      "value": 120
    },
    {
      "id": "recall-at-k",
      "class": "A",
      "metric": "recall@k",
      "op": "gte",
      "value": 0.95
    }
  ],
  "feedback": {
    "show_failing_cases": 3,
    "rotate": true
  },
  "attemptPolicy": {
    "maxSubmissions": 20,
    "cooldownHours": 1
  },
  "graderArchetype": "rag-r2",
  "isPublished": true
}
