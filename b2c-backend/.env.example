NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
MONGO_URI=mongodb://localhost:27017/b2c

# Auth (httpOnly cookies via Next.js /api proxy in dev)
AUTH_COOKIE_PATH=/api
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# OAuth (Google) — required only to enable POST /auth/oauth/google
GOOGLE_CLIENT_ID=

# Role bootstrap (comma-separated; user must sign up first, then restart server)
# BOOTSTRAP_ADMIN_EMAILS=you@example.com
# BOOTSTRAP_INSTRUCTOR_EMAILS=instructor@example.com

# CORS
CORS_ORIGIN=http://localhost:3000

# Job queue (BullMQ)
REDIS_URL=redis://localhost:6379
# Set to false on Render until a live Redis instance is configured
REDIS_ENABLED=true

# AI provider — OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
# Default model slug on OpenRouter (change to any supported model)
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Bina B2C
# Legacy fallback if OPENROUTER_API_KEY is unset:
# AI_PROVIDER_API_KEY=

# Sandbox execution (labs)
SANDBOX_EXECUTION_PROVIDER=docker-local
SANDBOX_EXECUTION_TIMEOUT_MS=5000
SANDBOX_MAX_MEMORY_MB=256

# Email (daily notifications)
EMAIL_PROVIDER_API_KEY=

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (profile avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
