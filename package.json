{
  "name": "labpath",
  "version": "0.1.0",
  "private": true,
  "description": "LabPath — practice platform for AI engineering",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @labpath/api",
    "dev:worker": "npm run start:worker:dev -w @labpath/api",
    "build:api": "npm run build -w @labpath/api",
    "start:api": "npm run start:prod -w @labpath/api",
    "start:worker": "npm run start:worker:prod -w @labpath/api",
    "dev:web": "npm run dev -w @labpath/web",
    "build:web": "npm run build -w @labpath/web",
    "lint": "npm run lint -w @labpath/api && npm run lint -w @labpath/web",
    "typecheck": "npm run typecheck -w @labpath/api && npm run typecheck -w @labpath/web",
    "test": "npm run test -w @labpath/api",
    "content:validate": "npm run content:validate -w @labpath/api",
    "sandbox:smoke": "npm run sandbox:smoke -w @labpath/api",
    "prisma:generate": "npm run prisma:generate -w @labpath/api",
    "prisma:migrate": "npm run prisma:migrate -w @labpath/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w @labpath/api",
    "prisma:seed": "npm run prisma:seed -w @labpath/api",
    "prisma:studio": "npm run prisma:studio -w @labpath/api"
  },
  "engines": {
    "node": ">=20"
  }
}
